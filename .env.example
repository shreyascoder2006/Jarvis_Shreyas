
# --- WhatsApp / SMS (Twilio) ---------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SMS_FROM=
# PUBLIC_BASE_URL=https://your-tunnel.example
# JARVIS_TWILIO_VALIDATE=1

# --- WhatsApp bridge (Baileys, unofficial -- see docs/MESSAGING.md) ------------------------
# Where the backend posts deferred (ack-then-async) replies. docker-compose.yml already sets
# this to http://whatsapp-bridge:3000 for the container stack; only needed here for a non-
# Docker / local run.
# WHATSAPP_BRIDGE_URL=http://localhost:3737
#
# Read by the bridge, not the backend -- the number to pair on first run (country code +
# digits, no +, e.g. 919876543210). Leave unset to be prompted on the bridge's terminal instead.
# WHATSAPP_PAIR_NUMBER=

# --- SMS gateway (a spare Android phone running SMS Gateway for Android, local mode) -------
# No Twilio, no cloud: the phone's own REST API, reachable over your LAN. See DEPLOY.md for the
# one-time setup (install the app, exempt it from battery optimization, register the webhook).
# SMS_GATEWAY_URL=http://192.168.1.50:8080
# SMS_GATEWAY_USER=
# SMS_GATEWAY_PASS=
